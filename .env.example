# Copy this file to .env and fill in your actual values

# Storage backend: `postgres` (default) or `memory` (no database; data lost on restart)
STORAGE=postgres

# Database connection details (only used when STORAGE=postgres)
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=your_database_password
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=mini_rust_api

# Server host & port (optional, defaults shown)
SERVER__HOST=0.0.0.0
SERVER__PORT=3000
# Comma-separated origins allowed to call the API from a browser (optional)
# SERVER__CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT signing secret - use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=change_me_to_a_long_random_secret

# Admin account ensured on startup (optional; set both or neither).
# Created if missing; an existing user with this email is promoted and keeps their password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123
